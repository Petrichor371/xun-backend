# ===== 服务端口 =====
PORT=3000

# ===== VAPID 密钥（Web Push 必需）=====
# 生成方式：npx web-push generate-vapid-keys
# 留空则启动时自动临时生成（重启会失效，仅适合本地测试；生产请固定填写）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知里显示的发送方邮箱（任意）
VAPID_SUBJECT=mailto:admin@example.com

# ===== 可选：真实大模型（OpenAI 兼容协议）=====
# 不填则用内置离线模拟话术生成主动消息
AI_ENDPOINT=
AI_KEY=
AI_MODEL=deepseek-chat

# ===== 主动消息频率控制 =====
# 每个设备每天最多主动发送几条
MAX_PER_DAY=4
# 两次主动消息之间最小间隔（毫秒），默认 3 小时
MIN_GAP_MS=10800000
# 每个调度周期（60 秒）的触发概率（实际发送还受上面的间隔/上限约束）
TICK_PROBABILITY=0.02
